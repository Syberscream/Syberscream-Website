{
  // Cloudflare Workers config: the site's static files, plus a small worker
  // (src/worker.js) that stores the client rotator list for the admin page.
  "name": "syberscream-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Storage for the client list. Cloudflare creates it on the first deploy.
  "kv_namespaces": [{ "binding": "SITE_KV" }]
}
